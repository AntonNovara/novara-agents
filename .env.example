# === Novara Agent Factory – Environment Template ===
# Copy to .env and fill in your values. Never commit .env to version control.

# LLM Provider
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Demo-Modus: true erzwingt Fake-LLM-Antworten statt echter API-Calls (auch mit
# gesetztem ANTHROPIC_API_KEY) — nützlich für lokale Entwicklung/Tests ohne
# Kosten. Ist implizit aktiv, wenn kein echter Key gesetzt ist. Reine
# Entwicklungs-Bequemlichkeit, kein Sicherheits-Default für öffentliche Demos.
DEMO_MODE=false

# API Security
API_SECRET_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# CRM / ERP Mock (Operations Agent)
CRM_ENDPOINT=https://crm.internal/api/v1
CRM_API_KEY=mock-key

# Landing-Page-Chat-Widget (Inbound-SDR, /api/v1/chat/landing): Termin-Link
# für als ICP qualifizierte Besucher. Default = realer Link aus novara_wissen.txt.
DEMO_BOOKING_URL=https://calendar.app.google/Dqmz7HkW2XNktT6q6

# GuardianAgent (agents/guardian_agent.py, GET /api/v1/health/audit): URL,
# gegen die der Netlify-Frontend-Check einen echten HTTP-GET macht. Default
# ist die Netlify-eigene Subdomain, NICHT novaraautomation.com -- deren
# Custom-Domain-DNS ist derzeit nicht auf Netlify delegiert.
NETLIFY_SITE_URL=https://novara-automation.netlify.app

# Baustellen-Voice-Assistant (agents/field_worker_agent.py, main.py
# POST /api/v1/webhook/whatsapp): Twilio-Zugangsdaten aus der Twilio Console
# (Account SID + Auth Token). Ohne TWILIO_AUTH_TOKEN wird die
# Twilio-Signaturprüfung übersprungen (nur für lokale Entwicklung ohne
# Twilio-Zugang gedacht) -- in Produktion MUSS er gesetzt sein.
TWILIO_ACCOUNT_SID=<aus der Twilio Console>
TWILIO_AUTH_TOKEN=<aus der Twilio Console>

# SDR Agent → Live-CRM-Sheet-Kopplung (Block C1). NUR lokale Entwicklung --
# hängt an einem OAuth-Token, der an diesen Mac gebunden ist (siehe
# tools/live_crm_bridge.py). Default aus: write_to_crm bleibt beim
# In-Memory-Mock, solange dies nicht explizit auf true steht.
SDR_CRM_LIVE_SHEET=false
LA_MAQUINA_DE_CONFIANZA_PATH=../la-maquina-de-confianza

# Google Calendar (book_appointment Tool für Voice Agent)
# Anleitung: python get_token.py ausführen → Werte hierher kopieren
GOOGLE_CLIENT_ID=<aus Google Cloud Console – OAuth 2.0 Client ID>
GOOGLE_CLIENT_SECRET=<aus Google Cloud Console – OAuth 2.0 Client Secret>
GOOGLE_REFRESH_TOKEN=<einmalig via get_token.py generieren>

# Voice Agent Sicherheits-Gate: VoiceAgent hat WÄHREND des Live-Gesprächs
# keine DLP-Schicht (siehe CLAUDE.md, Abschnitt "Voice Agent"). VoiceAgent()
# verweigert den Start, solange das hier nicht explizit auf true steht --
# erst nach bewusster Prüfung dieser Lücke setzen, nicht routinemäßig.
VOICE_AGENT_DLP_REVIEWED=false

# Lead-Capture-Benachrichtigung (core/lead_capture.py, tools/lead_notifier.py):
# Gmail-Anwendungspasswort (NICHT das normale Konto-Passwort — unter
# myaccount.google.com/apppasswords erzeugen, erfordert 2FA). Löst eine
# E-Mail an anton@novaraautomation.com aus, sobald der Landing-Chat oder ein
# Vapi-Anruf Kontaktdaten (E-Mail/Telefon) eines Besuchers erfasst. Ohne
# beide Werte wird der Versand übersprungen (fail-safe, kein Absturz).
SMTP_EMAIL=<dein-gmail-konto@gmail.com>
SMTP_PASSWORD=<Gmail-Anwendungspasswort>

# DSGVO / Data Residency
DATA_RESIDENCY_REGION=eu-central-1
ENABLE_PII_REDACTION=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment — in Railway auf "production" setzen (deaktiviert Swagger UI + API-Key-Bypass)
ENVIRONMENT=production
